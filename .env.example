# ==========================================
# MediFinder Environment Configuration
# ==========================================

# Server Environment (development | production | testing)
NODE_ENV=development
ENVIRONMENT=development
PORT=5000
HOST=0.0.0.0
DEBUG=True

# Application Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_SECRET_KEY=change_this_to_a_jwt_secret_in_production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# MongoDB Database Configuration
# In production, use MongoDB Atlas URI or Docker mongo service:
# MONGODB_URI=mongodb://localhost:27017/medifinder
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/medifinder?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medifinder
MONGODB_DB_NAME=medifinder

# System Admin Default Credentials
ADMIN_USER=admin
ADMIN_PASS=Admin@MediFinder2026!

# Upload Configuration
UPLOAD_FOLDER=backend/src/static/uploads
MAX_CONTENT_LENGTH=8388608 # 8MB in bytes

# Geolocation Defaults (Patna, Bihar)
DEFAULT_LAT=25.6110
DEFAULT_LNG=85.1430

# Reservation Policy
HOLD_WINDOW_HOURS=2
AUTO_CANCEL_EXPIRED=True
